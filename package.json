{
  "name": "cbb",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*"
  },
  "scripts": {
    "dev": "vite",
    "test:core": "node --test src/core/event/test/*.test.ts src/core/db/test/*.test.ts src/core/ecs/test/*.test.ts src/core/fsm/test/*.test.ts src/core/nav/test/*.test.ts src/core/time/*.test.ts",
    "test:game": "node --test src/game/test/*.test.ts",
    "test:all": "pnpm check:core && pnpm test:core && pnpm test:game",
    "check:core": "node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}