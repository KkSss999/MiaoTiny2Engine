{
  "name": "cbb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:core": "node --test 'src/core/**/*.test.ts'",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "test:all": "pnpm check:core && pnpm test && pnpm typecheck && pnpm build && pnpm sample",
    "check:core": "node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "sample": "node examples/headless.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "description": "Composable lightweight TypeScript game framework",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "exports": {
    ".": "./dist/index.js",
    "./core/*": "./dist/core/*/index.js",
    "./engine/*": "./dist/engine/*/index.js",
    "./render": "./dist/render/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ]
}
